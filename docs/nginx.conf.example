# TLS certificates must be provisioned separately.
server {
    listen 80;
    server_name research.example.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name research.example.com;
    ssl_certificate /etc/letsencrypt/live/research.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/research.example.com/privkey.pem;

    # Match MAX_ARTIFACT_BYTES. S3 direct transfers do not pass through this proxy.
    client_max_body_size 1024m;
    # Signed URL query strings are credentials: omit them from access logs.
    access_log off;
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 900s;
        proxy_request_buffering off;
    }
}
