{
  "name": "grt-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w server && npm run build -w web",
    "start": "npm run start -w server",
    "check": "npm run check -w server && npm run check -w web",
    "test": "npm run test -w server",
    "db:migrate": "npm run db:migrate -w server",
    "storage:migrate": "tsx scripts/migrate-storage.ts",
    "account:setup": "npm run account:setup -w server",
    "account:reset": "npm run account:reset -w server",
    "cli": "tsx scripts/grt.ts",
    "test:e2e": "npm run build && playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
