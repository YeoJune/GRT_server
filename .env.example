# Copy to .env at the repository root. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Browser origin: use http://localhost:5173 for Vite; your HTTPS origin in production.
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# Number of trusted reverse proxies (0 when directly exposed).
TRUST_PROXY=0

# sqlite | pg (PostgreSQL, including AWS RDS PostgreSQL)
DB_CLIENT=sqlite
SQLITE_FILENAME=./data/grt.sqlite
DATABASE_URL=
DB_SSL=false
# Optional PEM CA file for RDS certificate verification. Never disable verification.
DB_SSL_CA_FILE=

# Used only by account:setup / account:reset; never creates an account at server startup.
OWNER_USERNAME=owner
OWNER_PASSWORD=
RESET_REVOKE_TOKENS=false

SESSION_MAX_SECONDS=28800
SESSION_IDLE_SECONDS=1800
LEASE_SECONDS=180
HEARTBEAT_SECONDS=30
MAX_JSON_BYTES=1048576
MAX_ARTIFACT_BYTES=1073741824
MAX_EXPORT_BYTES=2147483648

# local | s3; local is suitable for initial single-host development.
STORAGE_DRIVER=local
STORAGE_DIRECTORY=./data/artifacts
# Required random key (>=32 characters), e.g. openssl rand -hex 32.
STORAGE_SIGNING_KEY=
SIGNED_URL_SECONDS=300
# IAM role / AWS SDK default credential chain. Do not put AWS keys in notebook secrets.
AWS_REGION=ap-northeast-2
S3_BUCKET=
S3_PREFIX=grt/

# Optional offer search only. Paid allocation API is intentionally disabled in v0.1.
VAST_API_KEY=
